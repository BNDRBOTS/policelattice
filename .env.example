# ===========================================================================
# Police Lattice configuration
#
# Every data endpoint used by the pipeline is either resolved live at runtime
# (Socrata discovery / ArcGIS Hub search) or pinned here. There are no mock
# endpoints and no placeholder example.com URLs: leave a variable unset and
# the pipeline reports that source as unconfigured — it never invents one.
# ===========================================================================

# Core
DATABASE_URL=postgresql+psycopg2://lattice:lattice@localhost:5432/police_lattice
APP_ENV=development
LOG_LEVEL=INFO

# --- Optional explicit endpoint pins (runtime discovery is the default) ---
# ArcGIS service URLs (override live discovery for Tempe/Phoenix layers)
# TEMPE_ARCGIS_SERVICE_URL=
# PHX_ARCGIS_SERVICE_URL=

# Flat-file datasets (defaults are the canonical public files; override to pin)
# WAPO_FATAL_FORCE_CSV_URL=https://raw.githubusercontent.com/washingtonpost/data-police-shootings/master/fatal-police-shootings-data.csv
# MPV_DATASET_CSV_URL=

# Live PDF documents (comma-separated URLs; e.g. DOJ Phoenix PD report)
# DOJ_PHX_REPORT_URLS=

# News feeds (defaults in source_catalog.yaml are live public feeds; override)
# ABC15_RSS_URL=
# FOX10_RSS_URL=
# KTAR_RSS_URL=
# CRONKITE_RSS_URL=
# PROPUBLICA_RSS_URL=
# PHOENIX_NEW_TIMES_RSS_URL=
# AZ_FREE_NEWS_RSS_URL=

# --- Authenticated live APIs (records are fetched only when set) ---
COURTLISTENER_TOKEN=
MUCKROCK_TOKEN=
MUCKROCK_USERNAME=

# --- Retrieval ---
# Semantic embedding model (fastembed / ONNX, MTEB-top small model)
SEMANTIC_MODEL=BAAI/bge-small-en-v1.5
SEARCH_RESULT_LIMIT=50

# --- Monthly chron-archive protocol ---
ARCHIVE_ENABLED=true
ARCHIVE_BACKFILL_MONTHS=24
MONTHLY_REFRESH_CRON_DAY=1
MONTHLY_REFRESH_CRON_HOUR=2

# --- Verify phase thresholds ---
VERIFY_MAX_RECORD_AGE_DAYS=3650
VERIFY_REQUIRE_PROVENANCE=true

# --- Acquisition resilience ---
FETCH_TIMEOUT_SECONDS=20
FETCH_MAX_RETRIES=3

# Tesseract OCR binary (scanned PDF pages)
TESSERACT_CMD=tesseract

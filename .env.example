# ---------------------------------------------------------------------------
# Police Lattice configuration. Every value below is optional unless noted.
# There are no credentials and no API keys: every configured source is a
# public, unauthenticated endpoint.
# ---------------------------------------------------------------------------

# Railway injects this automatically when a Postgres plugin is attached.
# Without it the app falls back to SQLite under ./data for local runs.
# DATABASE_URL=postgresql://user:pass@host:5432/railway

APP_ENV=production
LOG_LEVEL=INFO

# --- verified public endpoints ---------------------------------------------
PHOENIX_CKAN_URL=https://www.phoenixopendata.com
PHOENIX_CKAN_ORGANIZATION=police-department
TEMPE_HUB_URL=https://data.tempe.gov
ARCGIS_ONLINE_URL=https://www.arcgis.com

# --- acquisition bounds -----------------------------------------------------
# CKAN's datastore paginates server-side; these keep a sweep bounded.
CKAN_PAGE_SIZE=1000
CKAN_MAX_ROWS_PER_RESOURCE=20000
ACQUISITION_LOOKBACK_MONTHS=26

# --- transport --------------------------------------------------------------
HTTP_TIMEOUT_SECONDS=60
HTTP_RETRIES=3
HTTP_CONCURRENCY=6

# --- retrieval --------------------------------------------------------------
# Semantic leg downloads BAAI/bge-small-en-v1.5 (~34 MB) on first use and
# caches it under EMBEDDING_CACHE_DIR. If the model cannot be fetched the
# retriever degrades to lexical-only and says so in the API response.
SEMANTIC_SEARCH=true
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=./data/models

# --- scheduling (America/Phoenix) -------------------------------------------
SCHEDULER_ENABLED=true
# Full acquisition sweep.
ACQUISITION_CRON=*/30 * * * *
# Monthly refresh: pipeline, anomaly recomputation, month sealing.
MONTHLY_REFRESH_CRON=0 2 1 * *
